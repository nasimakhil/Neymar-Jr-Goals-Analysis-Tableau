      <aliases enabled='yes' />
      <column caption='Assist By' datatype='string' name='[Assist_By]' role='dimension' type='nominal' />
      <column caption='Metric Selection' datatype='integer' name='[Calculation_0444253649068039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 0444253648494598] WHEN &quot;Goals&quot; THEN SUM([Goals]) WHEN &#13;&#10;&quot;Penalties&quot; THEN SUM([Is_Penalty])&#13;&#10;WHEN  &quot;Matches&quot; THEN COUNTD([Match_ID]) END' />
      </column>
      <column caption='Penalty %' datatype='real' name='[Calculation_1622929951801344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Is_Penalty])/SUM([Goals])' />
      </column>
      <column caption='win%' datatype='real' name='[Calculation_1622929953353729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Match_Outcome] = &quot;Win&quot; THEN [Match_ID] END)/&#13;&#10;COUNTD([Match_ID])' />
      </column>
      <column datatype='string' name='[Club]' role='dimension' type='nominal' />
